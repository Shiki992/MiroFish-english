# LLM API configuration (supports any LLM API compatible with the OpenAI SDK format)
# Uses OpenAI by default: https://platform.openai.com/api-keys
# Note: usage can be costly, so try a simulation with fewer than 40 rounds first
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# To use Claude instead, replace the three lines above with these.
# Get a key at https://platform.claude.com/settings/keys
# LLM_EFFORT accepts low, medium, high, xhigh or max. It does not apply to
# simulation agents, which reach Claude through CAMEL.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your_claude_api_key_here
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL_NAME=claude-opus-5-5
# LLM_EFFORT=medium

# Optional: a cheaper model for simulation agents, which make the most calls.
# Reports and graph setup keep using LLM_MODEL_NAME. Use the same provider for both.
# LLM_SIMULATION_MODEL_NAME=claude-haiku-5-5

# Optional: recent messages each simulation agent keeps. Lower values use less memory
# and fewer tokens, but agents and interviews recall less. Default 20. 0 means no limit.
# SIMULATION_AGENT_MEMORY_MESSAGES=20

# ===== Knowledge graph (self-hosted Graphiti and FalkorDB) =====
# No account or API key is needed. Docker Compose sets the database host.
# Graph extraction uses LLM_API_KEY with GRAPH_LLM_MODEL_NAME, which defaults to
# claude-haiku-5-5 on Claude and LLM_MODEL_NAME on other providers.
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# GRAPH_LLM_MODEL_NAME=claude-haiku-5-5
# GRAPH_MAX_CONCURRENCY=8

# ===== Boost LLM configuration (optional) =====
# Note: if you are not using the boost configuration, do not include the following settings in the env file
# LLM_BOOST_PROVIDER is only needed if a claude-* model name is not detected.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
